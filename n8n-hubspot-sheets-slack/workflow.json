        "text": "={{ 'HubSpot deal sync failed in ' + $json.workflow.name + ' at ' + $json.execution.lastNodeExecuted + ': ' + $json.execution.error.message }}",
        "otherOptions": {}
      },
      "id": "99999999-9999-4999-8999-999999999999",
      "name": "Slack Error Alert",
